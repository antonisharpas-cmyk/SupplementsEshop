# ============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
#
# Nothing secret is hardcoded anywhere in src/ — every value below is read
# through process.env. DATABASE_URL is required and the app refuses to start
# without it. Entries marked "not read yet" belong to features still to be
# built (checkout, sessions-as-JWT); they are listed here so deployment can be
# configured once rather than twice.
# ============================================================================

# --- database (required) ---------------------------------------------------
# Postgres connection string. Any managed Postgres needs TLS.
#
#   No database installed? Run `npm run db:local` in its own terminal and use:
#       DATABASE_URL="postgresql://postgres@127.0.0.1:5432/postgres"
#       DATABASE_POOL_MAX=1
#
#   Render  : the database's "External Database URL" (the Internal one only
#             works from a service running inside Render).
#   Neon    : the pooled connection string from the dashboard.
#   Installed Postgres : postgresql://postgres:password@localhost:5432/storefront
DATABASE_URL="postgresql://user:password@host:5432/storefront?sslmode=require"

# TLS behaviour. Leave unset: encrypted and verified for a remote host, plain
# for localhost. Set to no-verify when the provider's certificate is not signed
# by a CA Node knows — Render is one, and the error reads
# "self-signed certificate in certificate chain". Still encrypted either way.
# Values: no-verify | disable
# DATABASE_SSL=no-verify

# Connections in the pool. Keep it low on serverless; the default is 10.
# DATABASE_POOL_MAX=10

# --- the site itself -------------------------------------------------------
# Absolute base URL, used for canonical links, sitemaps and Stripe redirects.
PUBLIC_SITE_URL="http://localhost:3000"

# --- payments (Stripe) ------------------------------------------------------
# Card details never reach this server: the browser talks to Stripe directly
# and this server only ever sees a payment intent id.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From the Stripe CLI (`stripe listen`) or the dashboard endpoint. Every webhook
# is signature-verified with this; without it, webhooks are rejected.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- email -----------------------------------------------------------------
# Codes, order emails, Customer Service, newsletters. With no provider set up
# every email is written to the server log and the email_log table instead,
# so everything works on a laptop.
#
# Google Workspace (Gmail), recommended:
#   1. Turn on 2 Step Verification for the sending account
#      (myaccount.google.com, Security).
#   2. Create an App password (myaccount.google.com/apppasswords) and paste
#      the 16 letters below. Spaces are fine.
#   3. If the Workspace admin has switched app passwords off, ask them to
#      allow them (Admin console, Security, Less secure apps / App passwords).
#   Workspace sends up to about 2,000 emails a day per account.
EMAIL_PROVIDER="gmail"            # gmail | resend
GMAIL_USER=""                     # e.g. orders@yourdomain.com
GMAIL_APP_PASSWORD=""
# Must be GMAIL_USER or an alias set up in that Gmail account ("Send mail as").
EMAIL_FROM="AIONIX <orders@yourdomain.com>"
# Only for EMAIL_PROVIDER="resend":
EMAIL_API_KEY=""

# --- SMS (sms.to) ------------------------------------------------------------
# Marketing SMS campaigns (Admin, Marketing & emails, SMS campaigns), sent only
# to customers who said yes to offers by SMS. Without a key, SMS are written
# to the server log instead.
#   1. Create an API key at sms.to (API Clients). Keep "Secure" ticked.
#   2. Register your sender name with sms.to (up to 11 letters or digits).
SMSTO_API_KEY=""
SMSTO_SENDER_ID="AIONIX"

# --- signing secret (required in production) ------------------------------
# Signs the newsletter confirm / unsubscribe links (sessions themselves are
# opaque database tokens). 16+ characters; the site refuses to sign links in
# production without it. Generate with: openssl rand -base64 48
JWT_SECRET=""

# --- Automations: Customer Service and automated emails -------------------
# Every 30 seconds the server closes quiet conversations, sends due automated
# emails (welcome, abandoned bag, order updates …) and starts scheduled
# campaigns — by itself. On a host that cannot keep a timer running
# (serverless), call
#   POST /api/cron/automations   with   Authorization: Bearer <CRON_SECRET>
# once a minute from the platform's scheduler (support-sweep still works, but
# only closes conversations). Without CRON_SECRET these answer 404. The staff
# notification address and idle time are in /admin/settings; the test email
# address and marketing frequency limit in /admin/emails/settings.
# CRON_SECRET=""
# AUTOMATIONS=off       # turn the built-in timer off (when cron does it)

# --- seeding (optional) ----------------------------------------------------
# The password given to the seeded admin account. Set it, or the seed refuses
# to create an admin outside development.
SEED_ADMIN_PASSWORD=""

# --- checks (optional) -----------------------------------------------------
# Where `npm run check` points. Defaults to http://localhost:3100.
# CHECK_BASE="http://localhost:3000"
